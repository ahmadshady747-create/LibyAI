# ==========================================
# LibyAI Clinic Reception Bot Configuration
# ==========================================

# AI / Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Clinic Identity & Settings
CLINIC_NAME=مصحة الشفاء التخصصية
CLINIC_ADDRESS=طرابلس - طريق الشط بالقرب من جزيرة الميناء
CLINIC_MAP_LINK=https://maps.google.com/?q=Tripoli+Clinic
EMERGENCY_PHONE=091-0000000 / 021-3333333
RECEPTION_PHONE=092-1111111

# WhatsApp Webhook Integration (Meta Cloud API or Gateway)
# SECURITY: these secrets have NO defaults in the code. A production
# deployment without them fails closed (webhooks reject, simulator admin
# rejects, and startup aborts without WHATSAPP_APP_SECRET). Replace every
# placeholder below with a real, private value; never commit a real .env.
WHATSAPP_VERIFY_TOKEN=your_strong_verify_token_here
WHATSAPP_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_APP_SECRET=your_strong_meta_app_secret_here
ADMIN_SECRET_KEY=your_strong_admin_key_here

# Environment: production is the default. Local development via run.py
# sets development automatically; any other start method must set it here.
ENVIRONMENT=development
# Comma-separated CORS origins (default is local origins only).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
# Simulator is disabled in production unless this is explicitly true AND
# a valid ADMIN_SECRET_KEY is provided.
ENABLE_PROD_SIMULATOR=false

# Server bind (run.py only; default is localhost).
LIBYAI_HOST=127.0.0.1
LIBYAI_PORT=8000

# Database (defaults to local SQLite clinic.db)
DATABASE_URL=sqlite:///./clinic.db
