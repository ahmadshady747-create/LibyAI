# ==========================================
# LibyAI Business Assistant Configuration
# Messenger-first, WhatsApp secondary — any commercial sector
# ==========================================

# AI / Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Business Identity & Settings (generic; CLINIC_* names are kept as
# backward-compatible aliases for the same values)
BUSINESS_NAME=متجر النور للإلكترونيات
BUSINESS_SECTOR=retail
BUSINESS_CURRENCY=LYD
CLINIC_NAME=مصحة الشفاء التخصصية
CLINIC_ADDRESS=طرابلس - طريق الشط بالقرب من جزيرة الميناء
CLINIC_MAP_LINK=https://maps.google.com/?q=Tripoli+Clinic
EMERGENCY_PHONE=091-0000000 / 021-3333333
RECEPTION_PHONE=092-1111111
# Sector: retail, restaurant, clinic, pharmacy, service_office,
# workshop, general, medical. Medical guardrails (emergency triage +
# clinical-advice restrictions) activate ONLY for clinic/pharmacy/medical.

# Channels: comma-separated, Messenger is primary.
# Messenger-only: ENABLED_CHANNELS=messenger
# Both channels:  ENABLED_CHANNELS=messenger,whatsapp
ENABLED_CHANNELS=messenger,whatsapp

# Messenger Webhook Integration (Meta Messenger Platform) — PRIMARY
# SECURITY: these secrets have NO defaults in the code. A production
# deployment without the secrets of every ENABLED channel fails closed
# (webhooks reject, simulator admin rejects, and startup aborts).
# Replace every placeholder below with a real, private value; never
# commit a real .env.
MESSENGER_APP_SECRET=your_strong_meta_app_secret_here
MESSENGER_VERIFY_TOKEN=your_strong_verify_token_here
MESSENGER_PAGE_ACCESS_TOKEN=your_messenger_page_access_token_here
MESSENGER_PAGE_ID=your_messenger_page_id_here

# WhatsApp Webhook Integration (Meta Cloud API or Gateway) — SECONDARY
# Optional: the app boots cleanly in Messenger-only mode without any
# WHATSAPP_* secret. Set these only when WhatsApp is enabled.
WHATSAPP_VERIFY_TOKEN=your_strong_verify_token_here
WHATSAPP_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_APP_SECRET=your_strong_meta_app_secret_here
ADMIN_SECRET_KEY=your_strong_admin_key_here

# Environment: production is the default. Local development via run.py
# sets development automatically; any other start method must set it here.
ENVIRONMENT=development
# Comma-separated CORS origins (default is local origins only).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
# Simulator is disabled in production unless this is explicitly true AND
# a valid ADMIN_SECRET_KEY is provided.
ENABLE_PROD_SIMULATOR=false

# Server bind (run.py only; default is localhost).
LIBYAI_HOST=127.0.0.1
LIBYAI_PORT=8000

# Database (defaults to local SQLite clinic.db)
DATABASE_URL=sqlite:///./clinic.db
